const express = require("express");
const mongoose = require("mongoose");
const Decimal = require("decimal.js");

const User = require("../models/User");
const Crypto = require("../models/Crypto");
const Quote = require("../models/Quote");
const Holding = require("../models/Holding");
const Transaction = require("../models/Transaction");

const {
    authenticateToken,
    requireRole,
    requirePasswordChanged
} = require("../middleware/authMiddleware");

const router = express.Router();

Decimal.set({
    precision: 40,
    rounding: Decimal.ROUND_HALF_UP
});

const MAX_QUANTITY_DECIMALS = 8;

function decimalString(value) {
    return value == null ? "0" : value.toString();
}

function validPositiveNumber(value) {
    if (typeof value !== "string" && typeof value !== "number") {
        return false;
    }

    const text = String(value).trim();

    if (
        text.length === 0 ||
        text.length > 40 ||
        !/^(?:\d+(?:\.\d*)?|\.\d+)$/.test(text)
    ) {
        return false;
    }

    try {
        return new Decimal(text).isFinite() &&
            new Decimal(text).greaterThan(0);
    } catch {
        return false;
    }
}

function toDecimal128(value) {
    return mongoose.Types.Decimal128.fromString(value.toString());
}

function money(value) {
    return new Decimal(value).toDecimalPlaces(
        2,
        Decimal.ROUND_HALF_UP
    );
}

function quantityString(value) {
    return new Decimal(value).toFixed(MAX_QUANTITY_DECIMALS);
}

function serializeHolding(holding, latestPrice) {
    const quantity = new Decimal(decimalString(holding.quantity));
    const price = new Decimal(decimalString(latestPrice));
    const value = money(quantity.mul(price));

    return {
        crypto: {
            id: holding.crypto._id.toString(),
            name: holding.crypto.name,
            symbol: holding.crypto.symbol,
            imageFilename: holding.crypto.imageFilename ?? null
        },
        quantity: quantity.toString(),
        latestPrice: price.toString(),
        estimatedValue: value.toFixed(2)
    };
}

router.use(
    authenticateToken,
    requireRole("ROLE_CLIENT"),
    requirePasswordChanged
);

// GET /api/wallet
router.get("/", async (req, res) => {
    try {
        const user = await User.findById(req.user.id).select(
            "_id euroBalance"
        );

        if (!user) {
            return res.status(401).json({
                message: "Account no longer exists."
            });
        }

        const holdings = await Holding.find({
            user: user._id,
            quantity: { $gt: mongoose.Types.Decimal128.fromString("0") }
        }).populate("crypto", "name symbol imageFilename");

        const result = [];

        for (const holding of holdings) {
            if (!holding.crypto) {
                continue;
            }

            const quote = await Quote.findOne({
                crypto: holding.crypto._id
            }).sort({ quoteDate: -1, _id: -1 });

            if (!quote) {
                result.push({
                    crypto: {
                        id: holding.crypto._id.toString(),
                        name: holding.crypto.name,
                        symbol: holding.crypto.symbol,
                        imageFilename: holding.crypto.imageFilename ?? null
                    },
                    quantity: decimalString(holding.quantity),
                    latestPrice: null,
                    estimatedValue: null
                });
                continue;
            }

            result.push(serializeHolding(holding, quote.price));
        }

        return res.json({
            euroBalance: money(decimalString(user.euroBalance)).toFixed(2),
            holdings: result
        });
    } catch (error) {
        console.error("Wallet retrieval error:", error.message);

        return res.status(500).json({
            message: "Unable to retrieve wallet."
        });
    }
});

// GET /api/wallet/transactions
router.get("/transactions", async (req, res) => {
    try {
        const transactions = await Transaction.find({
            user: req.user.id
        })
            .sort({ createdAt: -1, _id: -1 })
            .limit(100)
            .populate("crypto", "name symbol");

        return res.json({
            transactions: transactions.map((transaction) => ({
                id: transaction._id.toString(),
                type: transaction.type,
                crypto: transaction.crypto
                    ? {
                        id: transaction.crypto._id.toString(),
                        name: transaction.crypto.name,
                        symbol: transaction.crypto.symbol
                    }
                    : null,
                quantity: decimalString(transaction.quantity),
                pricePerUnit: decimalString(transaction.pricePerUnit),
                totalAmount: decimalString(transaction.totalAmount),
                createdAt: transaction.createdAt
            }))
        });
    } catch (error) {
        console.error("Transaction history error:", error.message);

        return res.status(500).json({
            message: "Unable to retrieve transaction history."
        });
    }
});

// POST /api/wallet/trade
// Body: { "cryptoId": "...", "type": "BUY"|"SELL", "quantity": "0.5" }
router.post("/trade", async (req, res) => {
    const { cryptoId, type, quantity } = req.body;

    if (
        typeof cryptoId !== "string" ||
        !mongoose.isValidObjectId(cryptoId)
    ) {
        return res.status(400).json({
            message: "A valid cryptocurrency ID is required."
        });
    }

    if (type !== "BUY" && type !== "SELL") {
        return res.status(400).json({
            message: 'Trade type must be "BUY" or "SELL".'
        });
    }

    if (!validPositiveNumber(quantity)) {
        return res.status(400).json({
            message: "Quantity must be a valid positive number."
        });
    }

    const requestedQuantity = new Decimal(String(quantity).trim());

    if (requestedQuantity.decimalPlaces() > MAX_QUANTITY_DECIMALS) {
        return res.status(400).json({
            message: "Quantity cannot have more than 8 decimal places."
        });
    }

    if (requestedQuantity.greaterThan("9999999999999999.99999999")) {
        return res.status(400).json({
            message: "Quantity is too large."
        });
    }

    if (
        !requestedQuantity.mul(1).isFinite() ||
        !requestedQuantity.mul(1).toString()
    ) {
        return res.status(400).json({
            message: "Invalid quantity."
        });
    }

    const session = await mongoose.startSession();
    let tradeResult;

    try {
        await session.withTransaction(async () => {
            const user = await User.findOne({
                _id: req.user.id,
                isActive: true
            }).session(session);

            if (!user) {
                const error = new Error("Account is inactive or no longer exists.");
                error.status = 401;
                throw error;
            }

            if (user.mustChangePassword) {
                const error = new Error(
                    "You must change your password before trading."
                );
                error.status = 403;
                error.code = "PASSWORD_CHANGE_REQUIRED";
                throw error;
            }

            const crypto = await Crypto.findById(cryptoId).session(session);

            if (!crypto) {
                const error = new Error("Cryptocurrency not found.");
                error.status = 404;
                throw error;
            }

            const quote = await Quote.findOne({
                crypto: crypto._id
            })
                .sort({ quoteDate: -1, _id: -1 })
                .session(session);

            if (!quote) {
                const error = new Error(
                    "No price quote is available for this cryptocurrency."
                );
                error.status = 409;
                throw error;
            }

            const price = new Decimal(quote.price.toString());

            if (!price.isFinite() || !price.greaterThan(0)) {
                const error = new Error("The stored quote is invalid.");
                error.status = 409;
                throw error;
            }

            const total = money(price.mul(requestedQuantity));

            if (!total.greaterThan(0)) {
                const error = new Error(
                    "Trade total must be at least €0.01."
                );
                error.status = 400;
                throw error;
            }

            let balance = new Decimal(user.euroBalance.toString());

            let holding = await Holding.findOne({
                user: user._id,
                crypto: crypto._id
            }).session(session);

            let currentQuantity = holding
                ? new Decimal(holding.quantity.toString())
                : new Decimal(0);

            if (type === "BUY") {
                if (balance.lessThan(total)) {
                    const error = new Error(
                        "Insufficient euro balance for this purchase."
                    );
                    error.status = 400;
                    throw error;
                }

                balance = balance.minus(total);
                currentQuantity = currentQuantity.plus(requestedQuantity);

                if (!holding) {
                    holding = new Holding({
                        user: user._id,
                        crypto: crypto._id,
                        quantity: toDecimal128("0")
                    });
                }
            } else {
                if (currentQuantity.lessThan(requestedQuantity)) {
                    const error = new Error(
                        "Insufficient cryptocurrency quantity to sell."
                    );
                    error.status = 400;
                    throw error;
                }

                balance = balance.plus(total);
                currentQuantity = currentQuantity.minus(requestedQuantity);
            }

            if (
                !balance.isFinite() ||
                balance.isNegative() ||
                balance.greaterThan("9999999999.99")
            ) {
                const error = new Error(
                    "The resulting euro balance is outside the supported range."
                );
                error.status = 400;
                throw error;
            }

            if (type === "BUY" || currentQuantity.greaterThan(0)) {
                holding.quantity = toDecimal128(
                    quantityString(currentQuantity)
                );
                await holding.save({ session });
            } else if (holding) {
                await Holding.deleteOne({
                    _id: holding._id,
                    user: user._id
                }).session(session);
            }

            user.euroBalance = toDecimal128(balance.toFixed(2));
            await user.save({ session });

            const transaction = new Transaction({
                user: user._id,
                crypto: crypto._id,
                type,
                quantity: toDecimal128(requestedQuantity.toFixed(8)),
                pricePerUnit: toDecimal128(price.toString()),
                totalAmount: toDecimal128(total.toFixed(2)),
                createdAt: new Date()
            });

            await transaction.save({ session });

            tradeResult = {
                transactionId: transaction._id.toString(),
                type,
                crypto: {
                    id: crypto._id.toString(),
                    name: crypto.name,
                    symbol: crypto.symbol
                },
                quantity: requestedQuantity.toString(),
                pricePerUnit: price.toString(),
                totalAmount: total.toFixed(2),
                euroBalance: balance.toFixed(2),
                holdingQuantity: currentQuantity.toString(),
                quoteDate: quote.quoteDate
            };
        });
    } catch (error) {
        if (error.status) {
            return res.status(error.status).json({
                message: error.message,
                ...(error.code ? { code: error.code } : {})
            });
        }

        if (error.code === 11000) {
            return res.status(409).json({
                message: "The holding changed concurrently. Please retry the trade."
            });
        }

        console.error("Wallet trade error:", error.message);

        return res.status(500).json({
            message: "Trade could not be completed. No partial trade was saved."
        });
    } finally {
        await session.endSession();
    }

    return res.status(201).json({
        message: type === "BUY"
            ? "Purchase completed successfully."
            : "Sale completed successfully.",
        trade: tradeResult
    });
});

module.exports = router;