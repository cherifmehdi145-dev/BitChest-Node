              <table className="client-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Symbol</th>
                    <th>Latest price</th>
                    <th>Quote date</th>
                    <th>Image filename</th>
                  </tr>
                </thead>

                <tbody>
                  {cryptos.map((crypto) => (
                    <tr key={crypto.id}>
