                              {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 8,
                              },
                            )}
                      </td>
                      <td>
  {crypto.quoteDate
    ? new Date(crypto.quoteDate).toLocaleDateString('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : '—'}
</td>
                      <td>{crypto.imageFilename || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    )
