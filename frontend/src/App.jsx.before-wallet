  function startEditClient(client) {
    setClientError('')
    setClientMessage('')
    setTemporaryPassword('')
    setTemporaryPasswordClient('')
    setEditingClient(client)
    setClientFirstName(client.firstName || '')
    setClientLastName(client.lastName || '')
    setClientEmail(client.email || '')
    setClientFormOpen(true)
  }

  async function handleClientSubmit(event) {
    event.preventDefault()
    setClientError('')
    setClientMessage('')
    setClientSaving(true)

    const payload = {
      firstName: clientFirstName.trim(),
      lastName: clientLastName.trim(),
      email: clientEmail.trim(),
    }

    try {
      if (editingClient) {
        const data = await apiRequest(
          `/users/clients/${encodeURIComponent(editingClient.id)}`,
          {
            method: 'PATCH',
            body: JSON.stringify(payload),
          }
        )

        setClientMessage(data.message || 'Client updated successfully.')
        resetClientForm()
        await loadClients()
      } else {
        const data = await apiRequest('/users/clients', {
          method: 'POST',
          body: JSON.stringify(payload),
        })

        setTemporaryPassword(data.temporaryPassword || '')
        setTemporaryPasswordClient(
          [data.client?.firstName, data.client?.lastName]
            .filter(Boolean)
            .join(' ') || payload.email
        )
        setClientMessage(data.message || 'Client created successfully.')
        resetClientForm()
        await loadClients()
      }
    } catch (err) {
      setClientError(err.message || 'Unable to save this client.')
    } finally {
      setClientSaving(false)
    }
  }

  async function handleDeactivateClient(client) {
    const confirmed = window.confirm(
      `Deactivate the account for ${client.firstName} ${client.lastName} (${client.email})? The account will be deactivated rather than permanently deleted.`
    )

    if (!confirmed) return

    setClientError('')
    setClientMessage('')
    setTemporaryPassword('')
    setTemporaryPasswordClient('')

    try {
      const data = await apiRequest(
        `/users/clients/${encodeURIComponent(client.id)}`,
        { method: 'DELETE' }
      )

      setClientMessage(data.message || 'Client deactivated successfully.')
      await loadClients()
    } catch (err) {
      setClientError(err.message || 'Unable to deactivate this client.')
    }
  }

  async function handleLogin(event) {
    event.preventDefault()
    setError('')
    setMessage('')
    setLoading(true)

    try {
      const response = await fetch(`${API_URL}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.message || 'Unable to sign in.')
      }

      sessionStorage.setItem('bitchest_token', data.token)
      sessionStorage.setItem('bitchest_user', JSON.stringify(data.user))

      setToken(data.token)
      setUser(data.user)
      setPassword('')
      setAdminView('dashboard')
      setMessage(data.message || 'Login successful.')
    } catch (err) {
      setError(
        err instanceof TypeError
          ? 'Cannot connect to the BitChest server. Make sure the backend is running.'
          : err.message
      )
    } finally {
      setLoading(false)
    }
  }

  async function handlePasswordChange(event) {
    event.preventDefault()
    setError('')
    setMessage('')

    if (newPassword !== confirmPassword) {
      setError('The new passwords do not match.')
      return
    }

    if (newPassword.length < 8) {
      setError('The new password must contain at least 8 characters.')
      return
    }

    setLoading(true)

    try {
      const response = await fetch(`${API_URL}/users/change-password`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ currentPassword, newPassword }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.message || 'Unable to change the password.')
      }

      if (data.token) {
        sessionStorage.setItem('bitchest_token', data.token)
        setToken(data.token)
      }

      if (data.user) {
        sessionStorage.setItem('bitchest_user', JSON.stringify(data.user))
        setUser(data.user)
      } else {
        const updatedUser = { ...user, mustChangePassword: false }
        sessionStorage.setItem('bitchest_user', JSON.stringify(updatedUser))
        setUser(updatedUser)
      }

      setCurrentPassword('')
      setNewPassword('')
      setConfirmPassword('')
      setMessage('Password changed successfully.')
    } catch (err) {
      setError(
        err instanceof TypeError
          ? 'Cannot connect to the BitChest server. Make sure the backend is running.'
          : err.message
      )
    } finally {
      setLoading(false)
    }
  }

  function handleLogout() {
    sessionStorage.removeItem('bitchest_token')
    sessionStorage.removeItem('bitchest_user')

    setToken('')
    setUser(null)
    setEmail('')
    setPassword('')
    setCurrentPassword('')
    setNewPassword('')
    setConfirmPassword('')
    setMessage('')
    setError('')
    setAdminView('dashboard')
    setClients([])
    setClientSearch('')
    setClientError('')
    setClientMessage('')
    setTemporaryPassword('')
    setTemporaryPasswordClient('')
    resetClientForm()
  }

