    setClientError('')
    setClientMessage('')
    setTemporaryPassword('')
    setTemporaryPasswordClient('')
    setClientFormOpen(false)
    setEditingClient(null)
  }

  function resetClientForm() {
    setClientFirstName('')
    setClientLastName('')
    setClientEmail('')
    setEditingClient(null)
    setClientFormOpen(false)
  }

  function startCreateClient() {
    setClientError('')
    setClientMessage('')
    setTemporaryPassword('')
