/* BitChest authentication layout */

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36px 20px;
  background:
    radial-gradient(circle at 12% 15%, rgba(53, 167, 255, 0.10), transparent 30%),
    radial-gradient(circle at 90% 85%, rgba(1, 255, 25, 0.08), transparent 28%),
    #f4f7fb;
}

.login-layout {
  width: 100%;
  max-width: 1020px;
  min-height: 590px;
  display: grid;
  grid-template-columns: 1fr 0.95fr;
  overflow: hidden;
  background: var(--bc-white);
  border: 1px solid rgba(56, 97, 140, 0.10);
  border-radius: 24px;
  box-shadow: 0 24px 70px rgba(27, 48, 70, 0.12);
}

.brand-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  padding: 44px;
  color: var(--bc-white);
  background: linear-gradient(145deg, #243f5d, var(--bc-blue) 65%, #244b70);
}

.brand-panel::before,
.brand-panel::after {
  position: absolute;
  content: "";
  border-radius: 50%;
  pointer-events: none;
}

.brand-panel::before {
  width: 300px;
  height: 300px;
  right: -115px;
  top: -105px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow:
    0 0 0 35px rgba(255, 255, 255, 0.035),
    0 0 0 75px rgba(255, 255, 255, 0.025);
}

.brand-panel::after {
  width: 210px;
  height: 210px;
  left: -100px;
  bottom: -100px;
  background: rgba(1, 255, 25, 0.07);
}

.brand-content,
.brand-top,
.brand-middle,
.brand-footer {
  position: relative;
  z-index: 1;
}

.brand-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-logo {
  display: block;
  width: 48px;
  height: 48px;
  object-fit: contain;
  flex-shrink: 0;
}

.brand-name {
  margin: 0;
  color: var(--bc-white);
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1.8px;
}

.brand-name span {
  color: var(--bc-green);
}

.brand-tagline {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.brand-message,
.brand-middle {
  margin-top: 105px;
}

.brand-message h2,
.brand-middle h2 {
  max-width: 370px;
  margin: 0 0 18px;
  color: var(--bc-white);
  font-size: clamp(2rem, 4vw, 2.8rem);
  line-height: 1.15;
  font-weight: 700;
  letter-spacing: -1.3px;
}

.brand-message h2 span,
.brand-middle h2 span,
.brand-accent-text {
  color: var(--bc-green);
}

.brand-message p,
.brand-middle p {
  max-width: 355px;
  margin: 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.95rem;
  line-height: 1.8;
}

.brand-accent {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 28px;
}

.brand-accent span {
  display: block;
  width: 28px;
  height: 4px;
  border-radius: 4px;
  background: var(--bc-green);
}

.brand-accent span:nth-child(2) {
  width: 14px;
  background: var(--bc-light-blue);
}

.brand-accent span:nth-child(3) {
  width: 8px;
  background: var(--bc-white);
  opacity: 0.75;
}

.brand-footer {
  margin-top: 45px;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.76rem;
  line-height: 1.6;
}

/* Login and password-change forms */

.form-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 56px 52px;
  background: var(--bc-white);
}

.form-content {
  width: 100%;
  max-width: 390px;
  margin: 0 auto;
}

.form-heading {
  margin-bottom: 32px;
}

.eyebrow,
.form-eyebrow {
  margin-bottom: 12px;
  color: var(--bc-blue);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 1.8px;
  text-transform: uppercase;
}

.form-heading h1,
.form-content h1 {
  margin: 0 0 10px;
  color: var(--bc-dark);
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -1px;
}

.form-heading p,
.form-subtitle {
  margin: 0;
  color: var(--bc-muted);
  font-size: 0.91rem;
  line-height: 1.6;
}

.form-field,
.form-group {
  margin-bottom: 21px;
}

.form-field label,
.form-group label {
  display: block;
  margin-bottom: 9px;
  color: #26384a;
  font-size: 0.84rem;
  font-weight: 700;
}

.form-field input,
.form-group input,
.form-control {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 50px;
  padding: 13px 15px;
  border: 1px solid var(--bc-border);
  border-radius: 10px;
  outline: none;
  background: #fbfcfe;
  color: var(--bc-dark);
  font-family: inherit;
  font-size: 0.9rem;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}

.form-field input:focus,
.form-group input:focus,
.form-control:focus {
  border-color: var(--bc-light-blue);
  background: var(--bc-white);
  box-shadow: 0 0 0 4px rgba(53, 167, 255, 0.13);
}

.form-field input::placeholder,
.form-group input::placeholder,
.form-control::placeholder {
  color: #9aa7b5;
}

.primary-button,
.submit-button {
  display: block;
  width: 100%;
  min-height: 51px;
  margin-top: 5px;
  padding: 12px 18px;
  border: none;
  border-radius: 10px;
  color: #12201a;
  background: var(--bc-green);
  font-family: inherit;
  font-size: 0.94rem;
  font-weight: 800;
  text-align: center;
  transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}

.primary-button:hover:not(:disabled),
.submit-button:hover:not(:disabled) {
  background: #00e817;
  box-shadow: 0 8px 22px rgba(1, 255, 25, 0.20);
  transform: translateY(-1px);
}

.primary-button:focus-visible,
.submit-button:focus-visible {
  outline: 3px solid var(--bc-light-blue);
  outline-offset: 3px;
}

.form-note {
  margin: 25px 0 0;
  color: var(--bc-muted);
  font-size: 0.77rem;
  line-height: 1.7;
  text-align: center;
}

.form-note strong {
  color: var(--bc-blue);
}

.alert {
  margin-bottom: 22px;
  padding: 13px 15px;
  border: 1px solid transparent;
  border-radius: 10px;
  font-size: 0.86rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.alert-error,
.alert-danger {
  color: #a72e38;
  background: #fff0f1;
  border-color: #ffd5d8;
}

.alert-success {
  color: #176b32;
  background: #edfff0;
  border-color: #bcebc5;
}

.logged-in-notice {
  margin-bottom: 22px;
  padding: 13px 15px;
  border-radius: 10px;
  color: var(--bc-blue);
  background: #eef6ff;
  font-size: 0.85rem;
  overflow-wrap: anywhere;
}

.logged-in-notice a {
  color: var(--bc-blue);
  font-weight: 700;
}

/* Dashboard */

.dashboard-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 15%, rgba(53, 167, 255, 0.08), transparent 30%),
    #f4f7fb;
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px max(24px, calc((100vw - 1100px) / 2));
  background: var(--bc-white);
  border-bottom: 1px solid var(--bc-border);
  box-shadow: 0 3px 16px rgba(27, 48, 70, 0.04);
}

.dashboard-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--bc-dark);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.8px;
}

.dashboard-brand img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.brand-green {
  color: var(--bc-green);
}

.secondary-button,
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 9px 16px;
  border: 1px solid var(--bc-border);
  border-radius: 9px;
  color: var(--bc-blue);
  background: var(--bc-white);
  font-size: 0.85rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
}

.secondary-button:hover,
.text-button:hover {
  border-color: var(--bc-blue);
  background: #eef6ff;
}

.dashboard-content {
  width: min(100% - 40px, 1000px);
  margin: 48px auto;
}

.dashboard-content h1 {
  margin: 0 0 12px;
  color: var(--bc-dark);
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -1px;
}

.dashboard-subtitle {
  margin: 0 0 30px;
  color: var(--bc-muted);
  line-height: 1.7;
}

.account-card,
.next-steps-card {
  padding: 28px;
  border: 1px solid rgba(56, 97, 140, 0.10);
  border-radius: 16px;
  background: var(--bc-white);
  box-shadow: 0 12px 36px rgba(27, 48, 70, 0.06);
}

.account-card h2,
.next-steps-card h2 {
  margin: 0 0 18px;
  color: var(--bc-dark);
  font-size: 1.15rem;
  font-weight: 800;
}

.account-card p {
  margin: 10px 0;
  color: var(--bc-muted);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.account-card strong {
  color: var(--bc-dark);
}

.next-steps-card {
  margin-top: 22px;
}

.next-steps-card p {
  color: var(--bc-muted);
  line-height: 1.7;
}

/* Responsive layout */

@media (max-width: 760px) {
  .login-page {
    padding: 22px 14px;
  }

  .login-layout {
    max-width: 480px;
    min-height: auto;
    grid-template-columns: 1fr;
    border-radius: 18px;
  }

  .brand-panel {
    min-height: 230px;
    padding: 28px 30px;
  }

  .brand-logo {
    width: 38px;
    height: 38px;
  }

  .brand-name {
    font-size: 2rem;
  }

  .brand-message,
  .brand-middle {
    margin-top: 35px;
  }

  .brand-message h2,
  .brand-middle h2 {
    max-width: 330px;
    margin-bottom: 10px;
    font-size: 1.8rem;
  }

  .brand-message p,
  .brand-middle p {
    font-size: 0.85rem;
  }

  .brand-footer {
    margin-top: 28px;
  }

  .form-panel {
    padding: 36px 30px 32px;
  }

  .form-heading {
    margin-bottom: 26px;
  }

  .form-heading h1,
  .form-content h1 {
    font-size: 1.75rem;
  }

  .dashboard-header {
    padding: 16px 20px;
  }

  .dashboard-content {
    margin: 30px auto;
  }

  .account-card,
  .next-steps-card {
    padding: 22px;
  }
}

@media (max-width: 380px) {
  .brand-panel,
  .form-panel {
    padding-right: 22px;
    padding-left: 22px;
  }

  .brand-tagline {
    font-size: 0.68rem;
    letter-spacing: 1.3px;
  }

  .dashboard-header {
    align-items: flex-start;
    flex-direction: column;
  }
}


/* =========================================================
   BitChest administrator dashboard
   ========================================================= */

.admin-page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #172033;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
}

.admin-layout,
.admin-layout * {
  box-sizing: border-box;
}

.admin-layout {
  display: flex;
  min-height: 100vh;
}

.admin-sidebar {
  display: flex;
  flex-direction: column;
  flex: 0 0 250px;
  width: 250px;
  padding: 28px 18px 20px;
  background: #111c2e;
  color: #fff;
}

.admin-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
  margin-bottom: 42px;
  color: #fff;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1px;
  text-decoration: none;
}

.admin-brand > span:last-child > span {
  color: #34d399;
}

.admin-brand-icon {
  display: grid;
  width: 39px;
  height: 39px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 12px;
  background: #10b981;
  color: #06251b;
  font-size: 22px;
  font-weight: 900;
}

.admin-sidebar-label {
  padding: 0 12px;
  margin: 0 0 12px;
  color: #8291a8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.admin-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 46px;
  padding: 12px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: #c6d0df;
  font-size: 13px;
  font-weight: 600;
}

.admin-nav-item.active {
  border-color: rgba(52, 211, 153, 0.16);
  background: rgba(16, 185, 129, 0.13);
  color: #6ee7b7;
}

.admin-nav-item.unavailable {
  color: #a8b5c8;
}

.admin-nav-icon {
  display: inline-grid;
  width: 22px;
  flex-shrink: 0;
  place-items: center;
  font-size: 17px;
}

.admin-nav-status {
  margin-left: auto;
  color: #8291a8;
  font-size: 9px;
  text-transform: uppercase;
}

.admin-sidebar-divider {
  height: 1px;
  margin: 24px 8px;
  background: #29364a;
}

.admin-sidebar-note {
  padding: 15px;
  border: 1px solid #29364a;
  border-radius: 12px;
  background: #172438;
}

.admin-note-title {
  margin-bottom: 7px;
  color: #e2e8f0;
  font-size: 12px;
  font-weight: 700;
}

.admin-sidebar-note p {
  margin: 0;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.7;
}

.admin-sidebar-bottom {
  margin-top: auto;
  padding-top: 26px;
}

.admin-main {
  flex: 1;
  min-width: 0;
}

.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 78px;
  padding: 16px 36px;
  border-bottom: 1px solid #e7ecf3;
  background: #fff;
}

.admin-topbar-title {
  margin-bottom: 4px;
  font-size: 14px;
  font-weight: 750;
}

.admin-topbar-caption {
  color: #718096;
  font-size: 12px;
}

.admin-topbar-account {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.admin-avatar {
  display: grid;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 50%;
  background: #d1fae5;
  color: #047857;
  font-size: 13px;
  font-weight: 800;
}

.admin-account-details {
  min-width: 0;
}

.admin-account-role {
  margin-bottom: 4px;
  font-size: 12px;
  font-weight: 750;
}

.admin-account-email {
  display: block;
  max-width: 260px;
  overflow-wrap: anywhere;
  color: #718096;
  font-size: 12px;
}

.admin-logout-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 38px;
  padding: 10px 13px;
  border: 1px solid #e7ecf3;
  border-radius: 9px;
  background: #fff;
  color: #475569;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.admin-logout-button:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
}

.admin-content {
  width: 100%;
  max-width: 1500px;
  padding: 36px;
  margin: 0 auto;
}

.admin-page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.admin-eyebrow {
  margin: 0 0 9px;
  color: #059669;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}

.admin-page-heading h1 {
  margin: 0 0 9px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 800;
  letter-spacing: -1px;
}

.admin-page-subtitle {
  max-width: 680px;
  margin: 0;
  color: #718096;
  font-size: 14px;
  line-height: 1.7;
}

.admin-active-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  padding: 10px 13px;
  border: 1px solid #a7f3d0;
  border-radius: 30px;
  background: #ecfdf5;
  color: #047857;
  font-size: 11px;
  font-weight: 750;
}

.admin-active-badge > span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
}

.admin-welcome-panel {
  position: relative;
  overflow: hidden;
  padding: 30px;
  margin-bottom: 30px;
  border: 1px solid #233c50;
  border-radius: 18px;
  background: linear-gradient(115deg, #142538, #1c3549);
  color: #fff;
}

.admin-welcome-panel::before,
.admin-welcome-panel::after {
  position: absolute;
  border: 1px solid rgba(110, 231, 183, 0.12);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.admin-welcome-panel::before {
  top: -40px;
  right: 10px;
  width: 165px;
  height: 165px;
}

.admin-welcome-panel::after {
  top: -85px;
  right: -35px;
  width: 245px;
  height: 245px;
}

.admin-welcome-content {
  position: relative;
  z-index: 1;
  max-width: 650px;
}

.admin-welcome-label {
  margin-bottom: 12px;
  color: #6ee7b7;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.admin-welcome-panel h2 {
  margin: 0 0 12px;
  font-size: clamp(22px, 2.5vw, 28px);
  font-weight: 750;
  letter-spacing: -0.5px;
}

.admin-welcome-panel p {
  max-width: 560px;
  margin: 0 0 23px;
  color: #bdcad8;
  font-size: 13px;
  line-height: 1.8;
}

.admin-welcome-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.admin-primary-action,
.admin-secondary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 11px 16px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 750;
}

.admin-primary-action {
  background: #34d399;
  color: #092a20;
}

.admin-secondary-action {
  border-color: #405367;
  background: rgba(255, 255, 255, 0.04);
  color: #f1f5f9;
}

.admin-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.admin-section-heading h2 {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.admin-section-heading > span {
  color: #718096;
  font-size: 11px;
}

.admin-overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.admin-overview-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 205px;
  padding: 23px;
  border: 1px solid #e7ecf3;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 2px 5px rgba(15, 23, 42, 0.015);
}

.admin-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.admin-card-icon {
  display: grid;
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 12px;
  background: #ecfdf5;
  color: #047857;
  font-size: 20px;
}

.admin-card-icon.blue {
  background: #eff6ff;
  color: #2563eb;
}

.admin-card-icon.purple {
  background: #f5f3ff;
  color: #7c3aed;
}

.admin-card-type {
  padding: 6px 8px;
  border-radius: 6px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.admin-overview-card h3 {
  margin: 0 0 8px;
  font-size: 15px;
  font-weight: 800;
}

.admin-overview-card > p {
  margin: 0;
  color: #718096;
  font-size: 12px;
  line-height: 1.8;
}

.admin-card-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 20px;
  color: #047857;
  font-size: 10px;
  font-weight: 800;
}

.admin-card-action span:last-child {
  font-size: 17px;
}

.admin-prototype-notice {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 17px 19px;
  margin-top: 26px;
  border: 1px solid #dbeafe;
  border-radius: 12px;
  background: #eff6ff;
}

.admin-notice-icon {
  display: grid;
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 9px;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 15px;
  font-weight: 800;
}

.admin-notice-title {
  margin: 1px 0 5px;
  color: #1e40af;
  font-size: 12px;
  font-weight: 800;
}

.admin-prototype-notice p {
  margin: 0;
  color: #475569;
  font-size: 11px;
  line-height: 1.8;
}

.admin-footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  padding: 22px 0 4px;
  color: #8a97a9;
  font-size: 10px;
  line-height: 1.7;
}

.admin-page button:focus-visible,
.admin-page a:focus-visible {
  outline: 3px solid #34d399;
  outline-offset: 3px;
}

/* Administrator dashboard responsive layout */

@media (max-width: 1100px) {
  .admin-sidebar {
    flex-basis: 220px;
    width: 220px;
  }

  .admin-content {
    padding: 28px;
  }

  .admin-topbar {
    padding-right: 28px;
    padding-left: 28px;
  }

  .admin-overview-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .admin-layout {
    display: block;
  }

  .admin-sidebar {
    width: 100%;
    padding: 18px;
  }

  .admin-brand {
    margin-bottom: 22px;
  }

  .admin-sidebar-label {
    margin-top: 12px;
  }

  .admin-sidebar-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-sidebar-divider,
  .admin-sidebar-bottom {
    display: none;
  }

  .admin-topbar {
    padding: 16px 20px;
  }

  .admin-content {
    padding: 24px 20px;
  }

  .admin-page-heading {
    flex-direction: column;
    gap: 14px;
  }

  .admin-welcome-panel {
    padding: 24px;
  }
}

@media (max-width: 520px) {
  .admin-sidebar-nav {
    grid-template-columns: 1fr;
  }

  .admin-topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .admin-topbar-account {
    width: 100%;
    flex-wrap: wrap;
  }

  .admin-account-email {
    max-width: 220px;
  }

  .admin-overview-grid {
    grid-template-columns: 1fr;
  }

  .admin-overview-card {
    min-height: 185px;
  }

  .admin-content {
    padding: 22px 16px;
  }

  .admin-welcome-panel {
    padding: 21px;
  }

  .admin-welcome-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-primary-action,
  .admin-secondary-action {
    width: 100%;
    text-align: center;
  }

  .admin-active-badge {
    white-space: normal;
  }

  .admin-footer {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-page *,
  .admin-page *::before,
  .admin-page *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Client management */
.admin-brand-button {
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  font: inherit;
}

.admin-nav-item {
  font: inherit;
  text-align: left;
}

.admin-overview-card-button {
  width: 100%;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.admin-overview-card-button:hover {
  transform: translateY(-2px);
}

.client-management-content {
  min-width: 0;
}

.client-form-panel,
.client-list-panel,
.temporary-password-panel {
  margin-top: 24px;
  padding: 24px;
  border: 1px solid #e4eaf0;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 8px 28px rgba(16, 24, 32, 0.04);
}

.client-panel-heading,
.client-list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 22px;
}

.client-panel-heading h2,
.client-list-heading h2,
.temporary-password-panel h2 {
  margin: 0;
  color: #101820;
  font-size: 1.25rem;
}

.client-list-heading p,
.temporary-password-panel p {
  margin: 8px 0 0;
  color: #728096;
  font-size: 0.9rem;
  line-height: 1.6;
}

.client-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.client-form-email {
  grid-column: 1 / -1;
}

.client-form-panel .form-field {
  margin-bottom: 0;
}

.client-form-panel input,
.client-search input,
.temporary-password-row input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.client-form-note {
  margin: 18px 0;
  color: #728096;
  font-size: 0.9rem;
}

.client-submit-button {
  margin-top: 22px;
  border: 0;
  cursor: pointer;
}

.client-submit-button:disabled,
.client-list-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.client-list-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.client-secondary-button,
.client-edit-button,
.client-deactivate-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 9px 13px;
  border: 1px solid #dce3eb;
  border-radius: 8px;
  background: #ffffff;
  color: #263447;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
}

.client-secondary-button:hover,
.client-edit-button:hover {
  background: #f4f7fa;
}

.client-search {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  max-width: 440px;
  margin-bottom: 20px;
}

.client-search label,
.temporary-password-panel label {
  color: #344256;
  font-size: 0.88rem;
  font-weight: 600;
}

.client-search input,
.temporary-password-row input {
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid #dce3eb;
  border-radius: 8px;
  background: #ffffff;
  color: #101820;
  font: inherit;
}

.client-search input:focus,
.client-form-panel input:focus,
.temporary-password-row input:focus {
  border-color: #35a7ff;
  outline: 3px solid rgba(53, 167, 255, 0.13);
}

.client-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.client-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.9rem;
}

.client-table th {
  padding: 13px 14px;
  border-bottom: 1px solid #e4eaf0;
  background: #f7f9fc;
  color: #65748a;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.045em;
  text-transform: uppercase;
  white-space: nowrap;
}

.client-table td {
  padding: 16px 14px;
  border-bottom: 1px solid #edf0f4;
  color: #344256;
  vertical-align: middle;
}

.client-table tbody tr:last-child td {
  border-bottom: 0;
}

.client-table td strong {
  color: #101820;
}

.client-status {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 0.76rem;
  font-weight: 700;
  white-space: nowrap;
}

.client-status-active {
  background: #e8f9ec;
  color: #14752b;
}

.client-status-inactive {
  background: #fff0f0;
  color: #a52828;
}

.client-password-status {
  display: block;
  margin-top: 7px;
  color: #946200;
  font-size: 0.76rem;
  line-height: 1.4;
}

.client-row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.client-deactivate-button {
  border-color: #f1caca;
  color: #a52828;
}

.client-deactivate-button:hover:not(:disabled) {
  background: #fff0f0;
}

.client-deactivate-button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.client-empty-state {
  padding: 36px 18px;
  border: 1px dashed #dce3eb;
  border-radius: 10px;
  color: #728096;
  text-align: center;
  line-height: 1.6;
}

.temporary-password-panel {
  border-color: #b9e8c4;
  background: #f5fff7;
}

.temporary-password-panel > p {
  color: #344256;
}

.temporary-password-panel label {
  display: block;
  margin: 18px 0 8px;
}

.temporary-password-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.temporary-password-row input {
  flex: 1;
  font-family: monospace;
  font-size: 1rem;
}

@media (max-width: 760px) {
  .client-form-grid {
    grid-template-columns: 1fr;
  }

  .client-form-email {
    grid-column: auto;
  }

  .client-list-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .client-list-actions {
    width: 100%;
    flex-wrap: wrap;
  }

  .client-table {
    min-width: 760px;
  }

  .temporary-password-row {
    align-items: stretch;
    flex-direction: column;
  }

  .client-row-actions {
    flex-wrap: wrap;
  }
}

@media (max-width: 520px) {
  .client-form-panel,
  .client-list-panel,
  .temporary-password-panel {
    padding: 17px;
  }


.crypto-history-panel {
  margin: 32px 0;
  padding: 24px;
  border: 1px solid #29374b;
  border-radius: 14px;
  background: #131d2e;
  color: #f1f5f9;
}

.crypto-history-panel .client-list-heading h2 {
  color: #f1f5f9;
}

.crypto-history-panel .client-list-heading p {
  color: #94a3b8;
}

.crypto-history-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
  margin-bottom: 22px;
}

.crypto-history-controls label {
  display: block;
  color: #94a3b8;
  font-size: 13px;
}

.crypto-history-controls select {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid #29374b;
  border-radius: 8px;
  background: #1a273b;
  color: #f1f5f9;
  font-size: 14px;
}

.crypto-history-controls select:focus {
  border-color: #37d996;
  outline: 2px solid rgb(55 217 150 / 20%);
  outline-offset: 1px;
}

.crypto-chart-container {
  min-width: 0;
}

.crypto-chart-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.crypto-chart-summary > div {
  min-width: 0;
  padding: 18px;
  border: 1px solid #29374b;
  border-radius: 12px;
  background: #1a273b;
}

.crypto-chart-summary span {
  display: block;
  margin-bottom: 10px;
  color: #94a3b8;
  font-size: 13px;
}

.crypto-chart-summary strong {
  display: block;
  overflow-wrap: anywhere;
  font-size: 22px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.crypto-chart-summary .crypto-positive {
  color: #37d996;
}

.crypto-chart-summary .crypto-negative {
  color: #f87171;
}

.crypto-chart-scroll {
  width: 100%;
  margin-top: 22px;
  overflow-x: auto;
  border: 1px solid #29374b;
  border-radius: 12px;
  background: #0b1120;
}

.crypto-history-chart {
  display: block;
  width: 100%;
  height: auto;
}

.history-disclaimer {
  margin-top: 14px;
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.6;
}

.crypto-history-panel .client-empty-state {
  border-color: #29374b;
  color: #94a3b8;
}

.crypto-history-panel .alert-error {
  margin: 12px 0;
}

@media (max-width: 600px) {
